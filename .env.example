# Copy this file to ".env" and fill in values to run in CLOUD mode.
# Local development needs NONE of these (it defaults to Ollama + local Postgres).
# The real ".env" is git-ignored and never committed.

# MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=your-gemini-api-key
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HTTP mode: bearer token clients must send. Required when serving beyond localhost (e.g. Docker).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAPERMIND_TOKEN=
